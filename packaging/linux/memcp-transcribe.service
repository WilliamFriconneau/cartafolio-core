# Voice notes: the recordings waiting in the inboxes become text through the speech service named in memcp.toml
# (transcribe = true). Started every minute by memcp-transcribe.timer; it does nothing while the option is off.
[Unit]
Description=MemCP voice notes
Documentation=https://github.com/WilliamFriconneau/memcp-core/blob/main/docs/LINUX.md
After=memcp.service

[Service]
Type=oneshot
User=memcp
Group=memcp
Environment=MEMCP_CONFIG=/etc/memcp/memcp.toml
StateDirectory=memcp-transcribe
StateDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/memcp prepare transcribe --out /var/lib/memcp-transcribe
ExecStart=/bin/sh -c 'f=/var/lib/memcp-transcribe/bridge.conf; [ -f "$f" ] || exit 0; exec /usr/bin/memcp-capture transcribe --config "$f"'
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/memcp
